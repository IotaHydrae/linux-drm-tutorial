#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# ga - Resolve a symbol+offset to a source line using addr2line.
#
# Usage: ga [options] <vmlinux_path> <symbol+offset>
# Example: ga <kernel-src>/vmlinux drm_atomic_connector_get_property+0x1a3
#
# Default output (unchanged): the first line of the addr2line result, so inline
# expansions do not push the outermost frame out of view.
#
# Exit codes (workspace convention): 0 success/PASS, 1 unresolved symbol (FAIL),
# 2 INVALID_USAGE, 3 ENVIRONMENT_ERROR, 4 TIMEOUT, 5 INCONCLUSIVE.

set -u

PROG="$(basename "$0")"
VERSION="1.0.0"

usage() {
    cat <<EOF
$PROG - resolve a kernel symbol+offset to a source file:line

Usage: $PROG [options] <vmlinux_path> <symbol+offset>
Example: $PROG /path/to/vmlinux drm_atomic_connector_get_property+0x1a3

Options:
  --help      show this help and exit 0
  --version   show the version and exit 0
  --json      emit one JSON result line
  --quiet     suppress the resolved file:line
  --verbose   print the computed address to stderr

Notes: the symbol lookup ignores __-prefixed symbols (function prefix padding)
so that the real function symbol is used.

Exit codes: 0 success, 1 unresolved symbol, 2 INVALID_USAGE,
            3 ENVIRONMENT_ERROR, 4 TIMEOUT, 5 INCONCLUSIVE
EOF
}

json=0
quiet=0
verbose=0
args=()

for arg in "$@"; do
    case "$arg" in
        --help) usage; exit 0 ;;
        --version) echo "$PROG $VERSION"; exit 0 ;;
        --json) json=1 ;;
        --quiet) quiet=1 ;;
        --verbose) verbose=1 ;;
        --) ;;
        -*) echo "Error: unknown option '$arg' (try --help)" >&2; exit 2 ;;
        *) args+=("$arg") ;;
    esac
done

die() {
    local code="$1"; shift
    if [ "$json" = 1 ]; then
        printf '{"tool":"%s","version":"%s","status":"error","error":"%s"}\n' \
            "$PROG" "$VERSION" "$*"
    else
        echo "Error: $*" >&2
    fi
    exit "$code"
}

if [ "${#args[@]}" -ne 2 ]; then
    if [ "$json" = 1 ]; then
        die 2 "expected <vmlinux_path> <symbol+offset>"
    fi
    usage >&2
    exit 2
fi

vmlinux="${args[0]}"
symoff="${args[1]}"

# Validate the symbol+offset format before touching the environment, so that a
# malformed request is INVALID_USAGE rather than ENVIRONMENT_ERROR.
symbol="$(printf '%s' "$symoff" | awk -F '+' '{print $1}')"
offset_str="$(printf '%s' "$symoff" | awk -F '+' '{print $2}')"

if [ -z "$symbol" ] || [ -z "$offset_str" ]; then
    die 2 "invalid symbol+offset format '$symoff' (expected 'symbol+offset')"
fi

if [[ "$offset_str" =~ ^0x[0-9a-fA-F]+$ ]] || [[ "$offset_str" =~ ^[0-9]+$ ]]; then
    offset=$(( offset_str ))
else
    die 2 "invalid offset '$offset_str' (expected decimal or 0x hex)"
fi

command -v nm >/dev/null 2>&1 || die 3 "nm not found (install binutils)"
command -v addr2line >/dev/null 2>&1 \
    || die 3 "addr2line not found (install binutils)"
[ -f "$vmlinux" ] || die 3 "vmlinux file '$vmlinux' not found"

addr_hex="$(nm "$vmlinux" | awk -v sym="$symbol" '
    $NF == sym && substr($NF, 1, 2) != "__" { print $1; exit }
')"
[ -n "$addr_hex" ] \
    || die 1 "could not find symbol '$symbol' (non-__) in $vmlinux"

addr_dec=$(( 16#$addr_hex ))
final_dec=$(( addr_dec + offset ))
printf -v final_hex '0x%x' "$final_dec"

[ "$verbose" = 1 ] && echo "ga: $symbol+$offset_str -> $final_hex" >&2

result="$(addr2line -e "$vmlinux" -i "$final_hex" | head -1)"

if [ "$json" = 1 ]; then
    printf '{"tool":"%s","version":"%s","status":"ok","input":{"vmlinux":"%s","symbol":"%s","offset":"%s"},"observation":{"file_line":"%s"}}\n' \
        "$PROG" "$VERSION" "$vmlinux" "$symbol" "$offset_str" "$result"
elif [ "$quiet" != 1 ]; then
    printf '%s\n' "$result"
fi
exit 0
